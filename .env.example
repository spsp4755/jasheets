# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# AI (선택 — 폐쇄망 내부의 OpenAI 호환 LLM 엔드포인트. 미설정 시 AI 기능 비활성)
# AI_BASE_URL=http://internal-llm:8000/v1
# OPENAI_API_KEY=internal-token

# Keycloak SSO (선택 — 네 값 모두 설정해야 로그인 페이지에 SSO 버튼이 나타남)
# PUBLIC_APP_URL=http://localhost:3000
# KEYCLOAK_URL=http://localhost:8081            # 브라우저가 접근하는 Keycloak 주소
# KEYCLOAK_INTERNAL_URL=http://localhost:8081   # 백엔드→Keycloak 내부 주소 (k8s: http://keycloak:8080)
# KEYCLOAK_REALM=jasheets
# KEYCLOAK_CLIENT_ID=jasheets
# KEYCLOAK_CLIENT_SECRET=your-client-secret
